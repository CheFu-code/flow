NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_CHEFU_ACCOUNT_URL=https://myaccount.chefuinc.com
NEXT_PUBLIC_FLOW_APP_URL=http://localhost:3001
# Must match backend FLOW_API_KEY when the backend enables it.
NEXT_PUBLIC_FLOW_API_KEY=

# Flow access-key auth
# Use a long random value in production so access cookies cannot be forged.
FLOW_ACCESS_SECRET=
# Required to register new employee keys in production.
FLOW_REGISTRATION_SECRET=
# Optional comma-separated bootstrap keys, e.g. "Ops:FLOW-OPS-2026,Sales:FLOW-SALES-2026".
FLOW_REGISTERED_KEYS=
# Optional local key registry path. Defaults to .flow-access/registered-keys.json.
FLOW_ACCESS_KEY_STORE=
